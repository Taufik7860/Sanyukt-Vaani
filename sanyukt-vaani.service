[Unit]
Description=Sanyukt Vaani FastAPI Backend
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/Sanyukt-Vaani
ExecStart=/home/ec2-user/Sanyukt-Vaani/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
